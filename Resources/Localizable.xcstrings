    "All values are real-time snapshots and refresh as the system reports new data." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All values are real-time snapshots and refresh as the system reports new data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有数值均为实时快照,会随系统上报的新数据刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有數值均為即時快照,會隨系統回報的新資料刷新。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有數值均為即時快照,會隨系統回報的新資料刷新。"
          }
        },
